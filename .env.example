# 로컬 개발용 JENNIFER OpenAPI 토큰
# 이 파일을 .env로 복사한 뒤 실제 토큰 값을 채워 넣으세요. .env는 절대 커밋하지 마세요.
# vite.config.js의 dev 서버 프록시가 요청 시점에 이 토큰을 붙여주므로,
# 클라이언트 코드/번들에는 토큰이 포함되지 않습니다.
DEV_API_TOKEN=

# --- 선택 항목 ---
# 개발 서버 프록시가 요청을 전달할 JENNIFER 서버. 기본은 https://demo.jennifersoft.co.jp/
# (운영의 nginx 프록시 대상에 해당합니다. 런타임 config.js 의 BASE_URL 은 더 이상 사용되지 않습니다)
# DEV_API_TARGET=https://your-jennifer-server/

# 개발 서버 바인딩 주소. 기본은 localhost (본인 PC에서만 접속).
# VM/컨테이너 밖에서 접속해야 할 때만 0.0.0.0 으로 지정하세요.
# 지정하면 같은 네트워크의 누구나 위 토큰이 붙은 /api 프록시를 사용할 수 있게 됩니다.
# DEV_HOST=0.0.0.0

# 업스트림(JENNIFER 서버) TLS 인증서 검증. 기본은 검증함.
# 개발 서버 터미널에 "self-signed certificate" / "http proxy error" 가 나오면
# (자가 서명 인증서 서버, 또는 사내 보안 장비의 TLS 검사 환경) 아래 둘 중 하나를 사용하세요.
#
#  (1) 간단: 검증을 끈다. 신뢰할 수 있는 네트워크의 개발 PC 에서만 사용하세요.
# DEV_INSECURE_TLS=1
#
#  (2) 권장: 검증은 유지하고 해당 CA/서버 인증서만 신뢰한다. 인증서를 PEM 으로 저장한 뒤
#      NODE_EXTRA_CA_CERTS=/경로/ca.pem npm run dev
